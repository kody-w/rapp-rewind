src/ocr
src/context
*.o
.DS_Store
__pycache__/

# Bytecode defeats the fragment trick the test fixtures rely on: Python
# constant-folds "gh" + "p_..." at COMPILE time, so a .pyc contains the
# joined credential-shaped literal even though no source file does, and
# the publishing gate reads it and says NO-GO — correctly.
*.pyc

# Native build products and generated test fixtures.
native/.build/
native/.swiftpm/
# Keep generated project files out of source control except the dependency pin.
native/*.xcodeproj/*
!native/*.xcodeproj/project.xcworkspace/
native/*.xcodeproj/project.xcworkspace/*
!native/*.xcodeproj/project.xcworkspace/xcshareddata/
native/*.xcodeproj/project.xcworkspace/xcshareddata/*
!native/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
native/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!native/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
native/build/
native/test-results/
