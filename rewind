#!/usr/bin/env python3
"""RAPP Rewind — a local, searchable memory of everything that was on your screen.

Captures the screen on an interval, reads the text with Apple's on-device Vision
OCR, and indexes it in SQLite FTS5 so you can search what you saw. Nothing leaves
the machine: no network calls anywhere in the capture, OCR, index or search path.

Measured on an Apple M4 (reproduce with `rewind bench`):
  capture              125 ms
  downscale to 1280px  ~40 ms   -> 259 KB/frame, 6.4x smaller than full Retina
  OCR                  1.4 s    -> 243 text lines at 0.99 confidence
  dedup                ~75% of consecutive frames are visually identical

Downscaling to 1280px recognises MORE text than the full-resolution capture
(243 lines vs 228), because it matches the scale Vision expects. Going lower
collapses it (149 lines at 1024px), so 1280 is a measured floor, not a guess.
"""

import argparse
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import time
from datetime import datetime, timedelta

HOME = os.path.expanduser("~")
ROOT = os.environ.get("REWIND_HOME", os.path.join(HOME, ".rapprewind"))
FRAMES = os.path.join(ROOT, "frames")
LOGS = os.path.join(ROOT, "logs")
DB = os.path.join(ROOT, "index.sqlite3")
# realpath, not abspath — install.sh symlinks `rewind` into ~/.local/bin, and
# abspath left BIN pointing there, so both Swift shims read as missing and
# capture silently indexed nothing.
BIN = os.path.dirname(os.path.realpath(__file__))
OCR = os.path.join(BIN, "src", "ocr")
CTX = os.path.join(BIN, "src", "context")
PIDFILE = os.path.join(ROOT, "capture.pid")
# NB: screencapture refuses a destination whose FILENAME begins with a dot — and
# exits 0 while writing nothing. Scratch files therefore live in a hidden
# directory with ordinary names, never as ~/.rapprewind/.shot.jpg.
SCRATCH = os.path.join(ROOT, ".scratch")

INTERVAL = float(os.environ.get("REWIND_INTERVAL", "4"))
WIDTH = int(os.environ.get("REWIND_WIDTH", "1280"))
QUALITY = int(os.environ.get("REWIND_QUALITY", "60"))
# Change detection on a 32x32 grey thumbnail. Two triggers, because one is not
# enough: a MEAN catches whole-screen changes, a MAX catches a small window
# opening in one corner that barely moves the average.
#
# Measured on this machine, and the separation is ~300x:
#   unchanged screen, 1s apart   mean 0.02   max  2
#   a Quick Look window appears  mean 6.39   max 32
#
# The first cut used mean<6 on a 16x16 grid. A small preview window scored 6.39 —
# just over the line — so it was flaky, and Rewind silently dropped frames that
# contained exactly the kind of thing you would later search for. Thresholds now
# sit an order of magnitude clear of the noise floor on both sides.
FP_GRID = int(os.environ.get("REWIND_FP_GRID", "32"))
SAME_MEAN = float(os.environ.get("REWIND_SAME_MEAN", "0.5"))
SAME_MAX = float(os.environ.get("REWIND_SAME_MAX", "12"))
MAX_CONSECUTIVE_ERRORS = int(os.environ.get("REWIND_MAX_ERRORS", "5"))


def _first_existing(*paths):
    """Apple Silicon puts Homebrew in /opt/homebrew, Intel in /usr/local."""
    for p in paths:
        if os.path.exists(p):
            return p
    return paths[0]


def ffmpeg():
    return shutil.which("ffmpeg") or _first_existing("/opt/homebrew/bin/ffmpeg", "/usr/local/bin/ffmpeg")


def run(args, **kw):
    return subprocess.run(args, capture_output=True, text=True, **kw)


def log(line):
    os.makedirs(LOGS, exist_ok=True)
    with open(os.path.join(LOGS, "rewind.log"), "a") as fh:
        fh.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ", time.gmtime()) + line + "\n")


# --------------------------------------------------------------------- database
SCHEMA = """
CREATE TABLE IF NOT EXISTS frames (
  id        INTEGER PRIMARY KEY,
  ts        REAL NOT NULL,          -- capture time, unix seconds
  until_ts  REAL NOT NULL,          -- extended while the screen stays unchanged
  app       TEXT,
  bundle    TEXT,
  title     TEXT,
  path      TEXT,                   -- relative to FRAMES; NULL once pruned
  bytes     INTEGER DEFAULT 0,
  fingerprint TEXT,
  lines     INTEGER DEFAULT 0,
  confidence REAL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS frames_ts ON frames(ts);
CREATE INDEX IF NOT EXISTS frames_app ON frames(app);
-- NOT contentless. A `content=''` table supports MATCH but stores no text, so
-- snippet() returns NULL and the timeline has nothing to show. OCR text is a few
-- KB per frame against ~200KB of image, so storing it is free in practice.
CREATE VIRTUAL TABLE IF NOT EXISTS frames_fts USING fts5(
  text, app, title, tokenize='unicode61'
);
CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
"""


def bump(conn, key, by=1):
    conn.execute("INSERT INTO meta (k, v) VALUES (?, ?) ON CONFLICT(k) DO UPDATE"
                 " SET v = CAST(CAST(v AS INTEGER) + ? AS TEXT)", (key, str(by), by))


def counter(conn, key):
    r = conn.execute("SELECT v FROM meta WHERE k=?", (key,)).fetchone()
    try:
        return int(r["v"]) if r else 0
    except Exception:
        return 0


def db():
    os.makedirs(ROOT, exist_ok=True)
    os.makedirs(FRAMES, exist_ok=True)
    c = sqlite3.connect(DB, timeout=30)
    c.row_factory = sqlite3.Row
    c.executescript(SCHEMA)
    migrate(c)
    return c


def migrate(c):
    """Rebuild a contentless frames_fts from an early build. Its text cannot be
    recovered (that is what contentless means), so affected frames are marked for
    re-OCR from the image we still have on disk."""
    row = c.execute("SELECT sql FROM sqlite_master WHERE name='frames_fts'").fetchone()
    if not row or "content=''" not in (row["sql"] or ""):
        return
    stale = [r["rowid"] for r in c.execute("SELECT rowid FROM frames_fts")]
    c.executescript("""
      DROP TABLE frames_fts;
      CREATE VIRTUAL TABLE frames_fts USING fts5(text, app, title, tokenize='unicode61');
    """)
    c.commit()
    log(f"migrated frames_fts to a content-storing table; {len(stale)} frame(s) need re-ocr")
    if stale:
        reocr(c, stale)


def reocr(c, ids):
    """Re-read text from the stored images for frames whose text was lost."""
    done = 0
    for fid in ids:
        r = c.execute("SELECT id, app, title, path FROM frames WHERE id=?", (fid,)).fetchone()
        if not r or not r["path"]:
            continue
        p = os.path.join(FRAMES, r["path"])
        if not os.path.exists(p):
            continue
        text, lines, conf = ocr_text(p)
        c.execute("DELETE FROM frames_fts WHERE rowid=?", (fid,))
        c.execute("INSERT INTO frames_fts (rowid, text, app, title) VALUES (?,?,?,?)",
                  (fid, text, r["app"] or "", r["title"] or ""))
        c.execute("UPDATE frames SET lines=?, confidence=? WHERE id=?", (lines, conf, fid))
        done += 1
    c.commit()
    if done:
        log(f"re-ocr complete for {done} frame(s)")


# ---------------------------------------------------------------- capture parts
def fingerprint(path):
    """Grey thumbnail as hex. Cheap enough to run on every frame, which is the
    point: an unchanged screen must not cost an OCR pass."""
    want = FP_GRID * FP_GRID
    p = subprocess.run(
        [ffmpeg(), "-hide_banner", "-loglevel", "error", "-i", path,
         "-vf", f"scale={FP_GRID}:{FP_GRID},format=gray", "-f", "rawvideo", "-"],
        capture_output=True)
    return p.stdout.hex() if p.returncode == 0 and len(p.stdout) == want else None


def fp_delta(a, b):
    """(mean, max) absolute difference. Returns a huge value when incomparable so
    an unreadable fingerprint always counts as a change rather than silently
    dropping the frame."""
    if not a or not b or len(a) != len(b):
        return 999.0, 999.0
    xa, xb = bytes.fromhex(a), bytes.fromhex(b)
    d = [abs(p - q) for p, q in zip(xa, xb)]
    return sum(d) / float(len(d)), float(max(d))


def is_same_screen(prev_fp, fp):
    mean, mx = fp_delta(prev_fp, fp)
    return mean < SAME_MEAN and mx < SAME_MAX


def screen_context():
    if not os.access(CTX, os.X_OK):
        return {}
    p = run([CTX], timeout=15)
    try:
        return json.loads(p.stdout or "{}")
    except Exception:
        return {}


def ocr_text(path):
    if not os.access(OCR, os.X_OK):
        # Loud, once per capture: an index that silently stores no text is worse
        # than no index, because search then lies by omission.
        log(f"OCR shim missing at {OCR} — frame stored with NO text. "
            f"Run ./install.sh to build the Swift shims.")
        return "", 0, 0.0
    p = run([OCR, path], timeout=120)
    try:
        d = json.loads((p.stdout or "").strip().splitlines()[-1])
        return d.get("text", ""), int(d.get("lines", 0)), float(d.get("confidence", 0))
    except Exception:
        return "", 0, 0.0


def capture_once(conn, verbose=False):
    """One frame. Returns ('new'|'same'|'error', detail)."""
    os.makedirs(SCRATCH, exist_ok=True)
    tmp = os.path.join(SCRATCH, "shot.jpg")
    small = os.path.join(SCRATCH, "small.jpg")
    for f in (tmp, small):
        if os.path.exists(f):
            os.remove(f)

    shot = run(["screencapture", "-x", "-t", "jpg", tmp], timeout=30)
    if not os.path.exists(tmp):
        # exit code is unreliable here — screencapture returns 0 on failure
        why = (shot.stderr or "").strip() or "no output and no error"
        return "error", f"screencapture wrote nothing: {why}"

    if run(["sips", "-Z", str(WIDTH), "-s", "format", "jpeg",
            "-s", "formatOptions", str(QUALITY), tmp, "--out", small],
           timeout=60).returncode != 0 or not os.path.exists(small):
        return "error", "sips downscale failed"
    os.remove(tmp)

    now = time.time()
    fp = fingerprint(small)
    prev = conn.execute("SELECT id, fingerprint FROM frames ORDER BY ts DESC LIMIT 1").fetchone()
    if prev and is_same_screen(prev["fingerprint"], fp):
        conn.execute("UPDATE frames SET until_ts=? WHERE id=?", (now, prev["id"]))
        bump(conn, "shots_same")
        conn.commit()
        os.remove(small)
        return "same", prev["id"]

    ctx = screen_context()
    text, lines, conf = ocr_text(small)
    day = datetime.fromtimestamp(now).strftime("%Y-%m-%d")
    os.makedirs(os.path.join(FRAMES, day), exist_ok=True)
    rel = os.path.join(day, f"{int(now * 1000)}.jpg")
    shutil.move(small, os.path.join(FRAMES, rel))
    size = os.path.getsize(os.path.join(FRAMES, rel))

    cur = conn.execute(
        "INSERT INTO frames (ts, until_ts, app, bundle, title, path, bytes,"
        " fingerprint, lines, confidence) VALUES (?,?,?,?,?,?,?,?,?,?)",
        (now, now, ctx.get("app"), ctx.get("bundle"), ctx.get("title"),
         rel, size, fp, lines, conf))
    conn.execute("INSERT INTO frames_fts (rowid, text, app, title) VALUES (?,?,?,?)",
                 (cur.lastrowid, text, ctx.get("app") or "", ctx.get("title") or ""))
    bump(conn, "shots_new")
    conn.commit()
    if verbose:
        print(f"  frame {cur.lastrowid}: {ctx.get('app')} — {lines} lines, {size // 1024}KB")
    return "new", cur.lastrowid


# ------------------------------------------------------------------- subcommands
def cmd_doctor(a):
    print("RAPP Rewind environment")
    print(f"  shims  {BIN}/src")
    checks = [
        ("screencapture", shutil.which("screencapture") is not None),
        ("sips (downscale)", shutil.which("sips") is not None),
        ("ffmpeg (fingerprint)", os.path.exists(ffmpeg())),
        ("OCR shim (Vision)", os.access(OCR, os.X_OK)),
        ("context shim", os.access(CTX, os.X_OK)),
    ]
    for name, good in checks:
        print(f"  {'ok  ' if good else 'MISS'} {name}")
    c = sqlite3.connect(":memory:")
    try:
        c.execute("CREATE VIRTUAL TABLE t USING fts5(x)")
        print("  ok   sqlite FTS5 search")
    except Exception:
        print("  MISS sqlite FTS5 — search unavailable")
    os.makedirs(SCRATCH, exist_ok=True)
    probe = os.path.join(SCRATCH, "probe.jpg")
    res = run(["screencapture", "-x", "-t", "jpg", probe], timeout=30)
    ok = os.path.exists(probe)
    if ok:
        print("  ok   screen capture works")
    else:
        # report what it actually said rather than guessing at permissions
        print(f"  MISS screen capture: {(res.stderr or '').strip() or 'wrote nothing'}")
        print("       if this mentions permission: System Settings >"
              " Privacy & Security > Screen Recording")
    if os.path.exists(probe):
        os.remove(probe)
    print(f"  running: {'yes (pid ' + open(PIDFILE).read().strip() + ')' if is_running() else 'no'}")
    print(f"  index:   {DB}")
    print(f"  frames:  {FRAMES}")
    print("\nNothing here uploads. Capture, OCR, index and search are all on-device.")
    return 0


def is_running():
    if not os.path.exists(PIDFILE):
        return False
    try:
        os.kill(int(open(PIDFILE).read().strip()), 0)
        return True
    except Exception:
        return False


def cmd_start(a):
    if is_running():
        print(f"already running (pid {open(PIDFILE).read().strip()})")
        return 0
    if a.foreground:
        return capture_loop(a.interval)
    # re-exec detached
    p = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "start", "--foreground",
         "--interval", str(a.interval)],
        stdout=open(os.path.join(LOGS, "capture.out"), "a"),
        stderr=subprocess.STDOUT, start_new_session=True)
    time.sleep(2)
    if p.poll() is None:
        print(f"capturing every {a.interval}s (pid {p.pid})")
        print(f"  search it with:  rewind search '<text you saw>'")
        return 0
    print("failed to start — see logs/capture.out")
    return 1


def capture_loop(interval):
    os.makedirs(LOGS, exist_ok=True)
    with open(PIDFILE, "w") as fh:
        fh.write(str(os.getpid()))
    conn = db()
    log(f"capture start interval={interval} width={WIDTH} q={QUALITY}")
    # A capture daemon that fails silently is the exact failure this product
    # exists to prevent, so consecutive failures are fatal rather than a loop
    # that fills a log nobody reads. The common cause is Screen Recording not
    # being granted to whatever launched this — a launchd agent does not inherit
    # the terminal's grant, so it fails every single time.
    consecutive = 0
    try:
        while True:
            t0 = time.time()
            try:
                kind, detail = capture_once(conn)
                if kind == "error":
                    consecutive += 1
                    log(f"capture error ({consecutive}/{MAX_CONSECUTIVE_ERRORS}): {detail}")
                    if consecutive >= MAX_CONSECUTIVE_ERRORS:
                        msg = (f"giving up after {consecutive} consecutive failures: {detail}. "
                               "If this says 'could not create image from display', the process "
                               "that launched capture has no Screen Recording permission — a "
                               "launchd agent does not inherit the terminal's grant. Run "
                               "`rewind start` from a terminal that does.")
                        log(msg)
                        print(msg, file=sys.stderr)
                        return 1
                else:
                    consecutive = 0
            except Exception as exc:
                consecutive += 1
                log(f"capture exception: {type(exc).__name__}: {exc}")
                if consecutive >= MAX_CONSECUTIVE_ERRORS:
                    msg = (f"giving up after {consecutive} consecutive exceptions: "
                           f"{type(exc).__name__}: {exc}")
                    log(msg)
                    print(msg, file=sys.stderr)
                    return 1
            time.sleep(max(0.5, interval - (time.time() - t0)))
    except KeyboardInterrupt:
        pass
    finally:
        log("capture stop")
        if os.path.exists(PIDFILE):
            os.remove(PIDFILE)
    return 0


def cmd_stop(a):
    if not is_running():
        print("not running")
        return 0
    pid = int(open(PIDFILE).read().strip())
    os.kill(pid, 15)
    for _ in range(20):
        time.sleep(0.2)
        if not is_running():
            break
    if os.path.exists(PIDFILE):
        os.remove(PIDFILE)
    print("stopped")
    return 0


def cmd_capture(a):
    conn = db()
    kind, detail = capture_once(conn, verbose=True)
    print(f"  {kind}: {detail}")
    return 0 if kind != "error" else 1


def cmd_search(a):
    conn = db()
    q = " ".join(a.query)
    where, params = ["frames_fts MATCH ?"], [q]
    if a.app:
        where.append("f.app LIKE ?")
        params.append(f"%{a.app}%")
    if a.since:
        where.append("f.ts >= ?")
        params.append(parse_since(a.since))
    sql = f"""SELECT f.id, f.ts, f.until_ts, f.app, f.title, f.path,
                     snippet(frames_fts, 0, '[', ']', ' … ', 12) AS snip
              FROM frames_fts JOIN frames f ON f.id = frames_fts.rowid
              WHERE {' AND '.join(where)}
              ORDER BY f.ts DESC LIMIT ?"""
    params.append(a.limit)
    try:
        rows = conn.execute(sql, params).fetchall()
    except sqlite3.OperationalError as exc:
        print(f"bad query: {exc}")
        return 2
    if not rows:
        print("no matches")
        return 1
    for r in rows:
        when = datetime.fromtimestamp(r["ts"]).strftime("%a %d %b %H:%M:%S")
        held = int(r["until_ts"] - r["ts"])
        print(f"\n\033[1m#{r['id']}\033[0m  {when}"
              f"{f' (+{held}s)' if held else ''}  \033[36m{r['app'] or '?'}\033[0m"
              f"{' — ' + r['title'] if r['title'] else ''}")
        print(f"    {(r['snip'] or '').replace(chr(10), ' ')[:300]}")
        if r["path"]:
            print(f"    \033[2m{os.path.join(FRAMES, r['path'])}\033[0m")
    print(f"\n{len(rows)} match(es)")
    return 0


def parse_since(s):
    s = s.strip().lower()
    now = time.time()
    units = {"m": 60, "h": 3600, "d": 86400, "w": 604800}
    if s and s[-1] in units and s[:-1].replace(".", "").isdigit():
        return now - float(s[:-1]) * units[s[-1]]
    try:
        return datetime.fromisoformat(s).timestamp()
    except Exception:
        return 0.0


def cmd_open(a):
    conn = db()
    r = conn.execute("SELECT path FROM frames WHERE id=?", (a.id,)).fetchone()
    if not r or not r["path"]:
        print("no image for that frame (pruned, or bad id)")
        return 1
    p = os.path.join(FRAMES, r["path"])
    subprocess.run(["open", p])
    print(p)
    return 0


def cmd_stats(a):
    conn = db()
    row = conn.execute(
        "SELECT COUNT(*) n, COALESCE(SUM(bytes),0) b, MIN(ts) lo, MAX(until_ts) hi,"
        " COALESCE(SUM(until_ts-ts),0) held FROM frames").fetchone()
    n, b = row["n"], row["b"]
    if not n:
        print("index is empty — run: rewind start")
        return 0
    new_c, same_c = counter(conn, "shots_new"), counter(conn, "shots_same")
    shots = new_c + same_c
    print("RAPP Rewind index")
    print(f"  frames stored     {n:,}")
    print(f"  disk              {b / 1e9:.2f} GB ({b / max(n,1) / 1024:.0f} KB/frame)")
    print(f"  first             {datetime.fromtimestamp(row['lo']).strftime('%a %d %b %H:%M')}")
    print(f"  last              {datetime.fromtimestamp(row['hi']).strftime('%a %d %b %H:%M')}")
    # Dedup and the storage projection are measured against SHOTS TAKEN, not
    # wall-clock: capture is often not running, and dividing by elapsed time
    # reports a dedup rate and a GB/day that are simply wrong.
    if shots:
        print(f"  shots taken       {shots:,} ({new_c:,} stored, {same_c:,} deduped)")
        print(f"  dedup rate        {100 * same_c / shots:.0f}% of shots needed no new frame")
        active = shots * INTERVAL
        print(f"  capture time      {active / 3600:.1f} h at {INTERVAL:g}s intervals")
        if active > 60:
            print(f"  projected         {b / active * 86400 / 1e9:.2f} GB per 24h of capture")
    else:
        print("  shots taken       (not recorded — counters added after these frames)")
    if row["held"] > 0:
        print(f"  screen held still {row['held'] / 60:.0f} min across stored frames")
    top = conn.execute(
        "SELECT app, COUNT(*) c FROM frames WHERE app IS NOT NULL"
        " GROUP BY app ORDER BY c DESC LIMIT 6").fetchall()
    if top:
        print("  most seen         " + ", ".join(f"{r['app']} ({r['c']})" for r in top))
    return 0


def cmd_prune(a):
    conn = db()
    cutoff = time.time() - a.days * 86400
    rows = conn.execute("SELECT id, path, bytes FROM frames WHERE ts < ? AND path IS NOT NULL",
                        (cutoff,)).fetchall()
    if not rows:
        print(f"nothing older than {a.days} days has an image")
        return 0
    freed = sum(r["bytes"] or 0 for r in rows)
    if not a.yes:
        print(f"would drop {len(rows):,} images ({freed / 1e9:.2f} GB) older than {a.days} days.")
        print("  text stays searchable. re-run with --yes to do it.")
        return 0
    for r in rows:
        p = os.path.join(FRAMES, r["path"])
        if os.path.exists(p):
            os.remove(p)
        conn.execute("UPDATE frames SET path=NULL, bytes=0 WHERE id=?", (r["id"],))
    conn.commit()
    for day in sorted(os.listdir(FRAMES)):
        d = os.path.join(FRAMES, day)
        if os.path.isdir(d) and not os.listdir(d):
            os.rmdir(d)
    print(f"dropped {len(rows):,} images, freed {freed / 1e9:.2f} GB; text still searchable")
    log(f"prune days={a.days} images={len(rows)} freed={freed}")
    return 0


def cmd_bench(a):
    """Reproduce the numbers in the docs on this machine."""
    os.makedirs(ROOT, exist_ok=True)
    os.makedirs(SCRATCH, exist_ok=True)
    shot = os.path.join(SCRATCH, "bench.jpg")
    t0 = time.time()
    run(["screencapture", "-x", "-t", "jpg", shot], timeout=30)
    t_cap = time.time() - t0
    if not os.path.exists(shot):
        print("capture failed — Screen Recording permission?")
        return 1
    full = os.path.getsize(shot)
    out = {"capture_ms": round(t_cap * 1000), "full_bytes": full, "variants": []}
    for w, q in ((1600, 70), (1280, 60), (1024, 50)):
        v = os.path.join(SCRATCH, f"bench_{w}.jpg")
        t0 = time.time()
        run(["sips", "-Z", str(w), "-s", "format", "jpeg", "-s", "formatOptions", str(q),
             shot, "--out", v], timeout=60)
        t_scale = time.time() - t0
        t0 = time.time()
        _, lines, conf = ocr_text(v)
        t_ocr = time.time() - t0
        out["variants"].append({
            "width": w, "quality": q, "bytes": os.path.getsize(v),
            "shrink_x": round(full / max(os.path.getsize(v), 1), 1),
            "scale_ms": round(t_scale * 1000), "ocr_ms": round(t_ocr * 1000),
            "ocr_lines": lines, "ocr_confidence": round(conf, 3)})
        os.remove(v)
    os.remove(shot)
    out["note"] = ("More lines at 1280 than at full resolution is expected: "
                   "downscaling a Retina capture matches the text scale Vision "
                   "expects. 1024 collapses, so 1280 is a measured floor.")
    print(json.dumps(out, indent=2))
    return 0


def cmd_timeline(a):
    conn = db()
    since = parse_since(a.since) if a.since else time.time() - 86400
    rows = conn.execute(
        "SELECT f.id, f.ts, f.until_ts, f.app, f.title, f.path,"
        " (SELECT text FROM frames_fts WHERE rowid=f.id) txt"
        " FROM frames f WHERE f.ts >= ? ORDER BY f.ts DESC LIMIT ?",
        (since, a.limit)).fetchall()
    items = [{
        "id": r["id"], "ts": r["ts"],
        "when": datetime.fromtimestamp(r["ts"]).strftime("%H:%M:%S"),
        "day": datetime.fromtimestamp(r["ts"]).strftime("%a %d %b"),
        "held": int(r["until_ts"] - r["ts"]),
        "app": r["app"] or "", "title": r["title"] or "",
        "img": ("file://" + os.path.join(FRAMES, r["path"])) if r["path"] else None,
        "text": (r["txt"] or "")[:4000],
    } for r in rows]
    html = TIMELINE_HTML.replace("__DATA__", json.dumps(items))
    dest = a.out or os.path.join(ROOT, "timeline.html")
    with open(dest, "w") as fh:
        fh.write(html)
    print(f"{dest}  ({len(items)} frames)")
    if a.open:
        subprocess.run(["open", dest])
    return 0


TIMELINE_HTML = r"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>RAPP Rewind</title>
<style>
 :root{--bg:#0e1013;--panel:#171b21;--line:#252b35;--ink:#e9edf3;--dim:#98a2b3;--accent:#7cc4ff}
 @media(prefers-color-scheme:light){:root{--bg:#f5f6f8;--panel:#fff;--line:#e2e5ea;--ink:#1a1d23;--dim:#5b6472;--accent:#0b6bcb}}
 *{box-sizing:border-box}
 body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
 header{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:center;flex-wrap:wrap;position:sticky;top:0;background:var(--bg);z-index:5}
 h1{margin:0;font-size:16px}
 input{flex:1;min-width:180px;background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:8px 11px;font-size:13px}
 .count{color:var(--dim);font-size:12px}
 main{display:grid;grid-template-columns:minmax(240px,1fr) 2fr;gap:0;height:calc(100vh - 62px)}
 @media(max-width:760px){main{grid-template-columns:1fr;height:auto}}
 .list{overflow-y:auto;border-right:1px solid var(--line)}
 .row{padding:9px 14px;border-bottom:1px solid var(--line);cursor:pointer}
 .row:hover{background:var(--panel)}
 .row.sel{background:var(--panel);box-shadow:inset 3px 0 0 var(--accent)}
 .row .t{font-variant-numeric:tabular-nums;color:var(--dim);font-size:12px}
 .row .a{color:var(--accent);font-size:12px}
 .row .ti{font-size:12px;color:var(--dim);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
 .view{overflow-y:auto;padding:16px 20px}
 .view img{max-width:100%;border:1px solid var(--line);border-radius:10px;display:block;margin-bottom:14px}
 pre{white-space:pre-wrap;word-break:break-word;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;font:12px/1.5 ui-monospace,Menlo,monospace;color:var(--ink)}
 mark{background:var(--accent);color:#04243d;border-radius:2px}
 .empty{color:var(--dim);padding:24px}
</style></head><body>
<header>
 <h1>RAPP Rewind</h1>
 <input id="q" placeholder="search what you saw…" autofocus>
 <span class="count" id="count"></span>
</header>
<main>
 <div class="list" id="list"></div>
 <div class="view" id="view"><div class="empty">Pick a moment on the left.</div></div>
</main>
<script>
const DATA = __DATA__;
let shown = DATA, sel = null;
const $ = id => document.getElementById(id);
const esc = s => (s||"").replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));

function render(){
  $("count").textContent = shown.length + " of " + DATA.length + " frames";
  $("list").innerHTML = shown.length ? "" : '<div class="empty">No frames match.</div>';
  let day = null;
  shown.forEach(f => {
    if (f.day !== day) {
      day = f.day;
      const h = document.createElement("div");
      h.className = "row"; h.style.cursor = "default";
      h.innerHTML = '<b>' + esc(day) + '</b>';
      $("list").appendChild(h);
    }
    const d = document.createElement("div");
    d.className = "row" + (sel === f.id ? " sel" : "");
    d.innerHTML = '<div class="t">' + esc(f.when) + (f.held ? ' <span class="a">+' + f.held + 's</span>' : '') +
                  '</div><div class="a">' + esc(f.app) + '</div>' +
                  (f.title ? '<div class="ti">' + esc(f.title) + '</div>' : '');
    d.onclick = () => { sel = f.id; render(); show(f); };
    $("list").appendChild(d);
  });
}
function show(f){
  const q = $("q").value.trim();
  let txt = esc(f.text);
  if (q) {
    try { txt = txt.replace(new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + ')','gi'), '<mark>$1</mark>'); } catch(e){}
  }
  $("view").innerHTML =
    (f.img ? '<img loading="lazy" src="' + f.img + '" alt="">' : '<div class="empty">Image pruned — text kept.</div>') +
    '<pre>' + (txt || '(no text recognised)') + '</pre>';
}
$("q").oninput = () => {
  const q = $("q").value.trim().toLowerCase();
  shown = !q ? DATA : DATA.filter(f =>
    (f.text||"").toLowerCase().includes(q) ||
    (f.app||"").toLowerCase().includes(q) ||
    (f.title||"").toLowerCase().includes(q));
  render();
  const cur = shown.find(f => f.id === sel);
  if (cur) show(cur);
};
render();
</script></body></html>
"""


def ensure_dirs():
    for d in (ROOT, FRAMES, LOGS, SCRATCH):
        os.makedirs(d, exist_ok=True)


def main():
    ensure_dirs()
    p = argparse.ArgumentParser(
        prog="rewind",
        description="A local, searchable memory of everything on your screen. "
                    "Nothing is uploaded.")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("doctor", help="environment + permission check").set_defaults(fn=cmd_doctor)

    s = sub.add_parser("start", help="begin capturing")
    s.add_argument("--interval", type=float, default=INTERVAL)
    s.add_argument("--foreground", action="store_true")
    s.set_defaults(fn=cmd_start)

    sub.add_parser("stop", help="stop capturing").set_defaults(fn=cmd_stop)
    sub.add_parser("capture", help="grab one frame now").set_defaults(fn=cmd_capture)

    s = sub.add_parser("search", help="search what you saw")
    s.add_argument("query", nargs="+")
    s.add_argument("--app", help="restrict to an app name")
    s.add_argument("--since", help="e.g. 30m, 6h, 2d, or an ISO date")
    s.add_argument("--limit", type=int, default=20)
    s.set_defaults(fn=cmd_search)

    s = sub.add_parser("open", help="open a frame's screenshot")
    s.add_argument("id", type=int)
    s.set_defaults(fn=cmd_open)

    sub.add_parser("stats", help="frames, disk, dedup, projection").set_defaults(fn=cmd_stats)

    s = sub.add_parser("prune", help="drop old images, keep the text")
    s.add_argument("--days", type=int, default=30)
    s.add_argument("--yes", action="store_true")
    s.set_defaults(fn=cmd_prune)

    s = sub.add_parser("timeline", help="build the scrubbable HTML timeline")
    s.add_argument("--since", default="1d")
    s.add_argument("--limit", type=int, default=400)
    s.add_argument("--out")
    s.add_argument("--open", action="store_true")
    s.set_defaults(fn=cmd_timeline)

    sub.add_parser("bench", help="reproduce the capture/OCR numbers").set_defaults(fn=cmd_bench)

    a = p.parse_args()
    if not getattr(a, "fn", None):
        p.print_help()
        return 0
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
